# Estructura hoisted — necesario para Angular CLI y sus plugins
node-linker=hoisted

# Evitar que pnpm pregunte si instalar peers automáticamente
auto-install-peers=true

# Guardar lockfile siempre actualizado
save-lockfile=true

# Design system privado (@hospital-carlos-cisterna-calama) — GitHub Packages
@hospital-carlos-cisterna-calama:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
