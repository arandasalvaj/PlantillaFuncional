{
  "name": "plantilla-sistema-backend",
  "version": "1.0.0",
  "description": "Backend Express + TypeScript + Kysely (SQL Server) — plantilla oficial del Hospital Carlos Cisterna de Calama",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.33.2",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "pkgroll": "pkgroll",
    "format": "prettier --write .",
    "build": "tsc && pkgroll",
    "start": "node dist/index.js",
    "codegen": "kysely-codegen --dialect mssql --url \"mssql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT:-1433}/${DB_NAME}\" --out-file src/types/db.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "0.28.17",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tarn": "^3.1.2",
    "tedious": "^18.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "pkgroll": "^2.28.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
