# ============================================================
# Variables de entorno del Backend — plantilla de referencia.
# Copiar a `Backend/.env` y completar para desarrollo local.
# En el clúster TODO esto lo inyectan los manifests k8s/ (los
# valores sensibles vía Secrets). JAMÁS commitear el `.env`.
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
# Puerto HTTP del backend. 3010 y NO 3000: en local el 3000 lo ocupa ApiLogin V2.
PORT=3010
# Ambiente: development habilita logs legibles; el clúster fija production
NODE_ENV=development
# Versión que expone GET /healthz (el CI la inyecta en la imagen; local es informativa)
APP_VERSION=0.0.0-local
# Carpeta del frontend compilado que sirve Express (default: ../public relativo a dist)
# PUBLIC_DIR=/ruta/al/frontend/compilado

# ── Rate limit del perímetro /api ────────────────────────────
# Ventana del rate-limit en milisegundos (default 900000 = 15 min)
RATE_LIMIT_WINDOW_MS=900000
# Máximo de requests por IP dentro de la ventana (default 300)
RATE_LIMIT_MAX_REQUESTS=300

# ── CORS ─────────────────────────────────────────────────────
# Orígenes permitidos extra, separados por coma.
# 4300 es el `ng serve` de este sistema (el 4200 lo ocupa el frontend de ApiLogin).
CORS_ORIGINS=http://localhost:4300

# ── SQL Server (Kysely / tedious) ────────────────────────────
# El backend NO arranca si esto no conecta: index.ts hace un SELECT 1 antes del listen.
DB_HOST=cambiame
DB_PORT=1433
DB_USER=cambiame
DB_PASS=cambiame
DB_NAME=db_Urgencia
# Tamaño máximo del pool de conexiones (default 5)
DB_POOL_MAX=5

# ── Autenticación contra ApiLogin V2 ─────────────────────────
# Secret HS256 compartido con ApiLogin para validar JWT — sin default: el backend
# falla rápido si falta. Tiene que ser EXACTAMENTE el mismo que usa ApiLogin,
# si no, ningún token valida.
JWT_SECRET=cambiame
# URL base de ApiLogin V2, SIN /api y sin slash final.
# Con ApiLogin corriendo en tu máquina: http://localhost:3000
API_LOGIN_URL=http://localhost:3000
# true = verificación TLS estricta hacia ApiLogin (producción); false en desarrollo
AUTH_TLS_VERIFY=false
# Nombre EXACTO y case-sensitive del sistema registrado en ApiLogin
SISTEMA_APILOGIN=URGENCIA_NEW
# TTL del caché de rol por usuario en milisegundos (default 300000 = 5 min)
ROLE_CACHE_TTL_MS=300000

# ── Logs (pino) ──────────────────────────────────────────────
# Nivel de log: trace | debug | info | warn | error (default info)
LOG_LEVEL=debug
